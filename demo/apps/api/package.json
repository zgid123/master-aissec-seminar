{
  "name": "@demo/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsup src/index.ts --format esm --clean --sourcemap && cp src/*.sql dist/",
    "typecheck": "tsc --noEmit",
    "db:seed": "node --import tsx src/seed.ts"
  },
  "dependencies": {
    "@demo/shared": "workspace:*",
    "@duckdb/node-api": "^1.5.5-r.4",
    "@hono/node-server": "^2.1.1",
    "hono": "^4.13.2"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "tsx": "^4.23.12",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2"
  }
}
